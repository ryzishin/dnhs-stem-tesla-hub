<div class="page-head">
  <p class="kicker">Practice Quizzes</p>
  <h1>Review anytime, unlimited retries</h1>
  <p class="muted">Items & options are randomized each attempt — practice until it's automatic. Points feed the leaderboard.</p>
</div>

<div class="stat-row">
  <div class="stat-card"><div class="stat-val"><%= user.points %></div><div class="stat-label">Total points</div></div>
  <div class="stat-card"><div class="stat-val"><i data-lucide="flame" class="inline-icon"></i> <%= user.streakDays || user.streak_days || 0 %></div><div class="stat-label">Day streak</div></div>
  <div class="stat-card"><div class="stat-val"><%= user.practiceQuizzesTaken || user.practice_quizzes_taken || 0 %></div><div class="stat-label">Quizzes taken</div></div>
  <div class="stat-card"><div class="stat-val"><%= attempts.length %></div><div class="stat-label">Your attempts</div></div>
</div>

<div class="grid grid-2">
  <% quizzes.forEach(q => {
    const qAttempts = attempts.filter(a => a.quiz_id === q.id);
    const best = qAttempts.reduce((m, a) => Math.max(m, a.score), 0);
  %>
    <div class="card">
      <div class="card-head">
        <h3><i data-lucide="brain" class="inline-icon"></i> <%= q.title %></h3>
        <span class="badge"><%= q.items.length %> items</span>
      </div>
      <p class="muted"><%= q.description %></p>
      <div class="card-meta">
        <span><i data-lucide="history" class="inline-icon"></i> <%= qAttempts.length %> attempt<%= qAttempts.length !== 1 ? 's' : '' %></span>
        <% if (qAttempts.length > 0) { %>
          <span>· <i data-lucide="trophy" class="inline-icon"></i> Best: <%= best %>/<%= q.items.length %></span>
        <% } %>
      </div>
      <a href="/practice/<%= q.id %>" class="btn btn-primary w-full">
        <%= qAttempts.length > 0 ? 'Practice again' : 'Start practice' %>
      </a>
    </div>
  <% }) %>
</div>
