{
  "name": "dnhs-stem-tesla-hub",
  "version": "1.0.0",
  "description": "DNHS STEM Tesla Hub for Biology 2 — class study hub (notes, practice quizzes, flashcards, live hosted tests, leaderboard). Built with Express, EJS, MongoDB, and Socket.IO.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:seed": "node scripts/seed.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dnhs",
    "stem",
    "tesla",
    "biology",
    "notes",
    "quizzes",
    "flashcards",
    "leaderboard",
    "live-test",
    "mongodb",
    "express",
    "ejs",
    "socket.io"
  ],
  "author": "DNHS STEM Tesla · Biology 2",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "csrf": "^3.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "socket.io": "^4.7.5",
    "ts-fsrs": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
