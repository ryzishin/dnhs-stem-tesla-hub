<div class="auth-page">
  <a href="/" class="back-link">← Back to home</a>
  <div class="auth-card">
    <div class="auth-head">
      <img src="/assets/stem-logo.jpeg" alt="STEM logo" class="auth-logo" />
      <h1>Forgot password</h1>
      <p class="muted">Enter your username. If the account exists, we'll send a reset link.</p>
    </div>

    <% if (locals.success) { %>
      <div class="alert alert-info"><%= success %></div>
      <p class="muted small center">
        In development, the reset link is logged to the server console — copy it from there.
      </p>
    <% } %>

    <% if (locals.error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="post" action="/forgot-password" class="auth-form" data-loading data-loading-text="Sending…">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Username</label>
      <input type="text" name="username" placeholder="althea" required autocomplete="username" />
      <button type="submit" class="btn btn-primary w-full">Send reset link</button>
      <p class="form-hint">Remembered it? <a href="/login">Sign in</a></p>
    </form>
  </div>
</div>
