<div class="page-head">
  <p class="kicker admin">Host Live Test</p>
  <h1><% if (activeSession) { %>Session in progress<% } else { %>Ready to host<% } %></h1>
</div>

<% if (activeSession) { %>
  <div class="card live-banner">
    <span class="live-pulse"></span>
    <div><strong><%= activeSession.quizzes && activeSession.quizzes.title %></strong><div class="muted small">Item <%= activeSession.current_item_index + 1 %> of <%= activeSession.quizzes && activeSession.quizzes.items ? activeSession.quizzes.items.length : 0 %></div></div>
    <div class="cta-row">
      <button class="btn btn-primary" id="next-item-btn" data-session="<%= activeSession.id %>">Next item →</button>
      <button class="btn btn-danger" id="end-session-btn" data-session="<%= activeSession.id %>">End session</button>
    </div>
  </div>

  <div class="card">
    <h3>Current item</h3>
    <% if (activeSession.quizzes && activeSession.quizzes.items) {
      const item = activeSession.quizzes.items[activeSession.current_item_index];
      if (item) { %>
        <p class="strong"><%= item.question %></p>
        <% if (item.options) { %>
          <div class="option-list">
            <% item.options.forEach(o => { %>
              <div class="option-row <%= o.is_correct ? 'correct' : '' %>">
                <span><%= o.text %></span>
                <% if (o.is_correct) { %><span class="badge correct">correct</span><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (item.correct_answer) { %>
          <p class="muted">Answer key: <strong><%= item.correct_answer %></strong></p>
        <% } %>
      <% } %>
    <% } %>
  </div>

  <div class="card">
    <h3>Live participant scores</h3>
    <div class="participant-list">
      <% (activeSession.participants || []).forEach(p => { %>
        <div class="participant-row">
          <div class="avatar avatar-sm" style="--avatar-hue: <%= p.profiles ? p.profiles.avatar_color : 152 %>;"><%= p.profiles ? (p.profiles.name || '').split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase() : '?' %></div>
          <strong><%= p.profiles ? p.profiles.name : 'Student' %></strong>
          <span class="badge <%= p.status === 'submitted' ? 'correct' : '' %>"><%= p.status %></span>
          <span class="badge">Score: <%= p.score %></span>
        </div>
      <% }) %>
    </div>
  </div>
<% } else { %>
  <div class="card">
    <h3>Available live tests</h3>
    <div class="quiz-list">
      <% (liveQuizzes || []).forEach(q => { %>
        <div class="quiz-list-row">
          <div><strong><%= q.title %></strong><div class="muted small"><%= q.items.length %> items · <%= q.time_limit_min || 30 %> min</div></div>
          <button class="btn btn-primary start-session-btn" data-quiz-id="<%= q.id %>"><i data-lucide="play" class="inline-icon"></i> Start</button>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>" src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  const socket = io({ auth: { userId: '<%= user.id %>' } });
  document.querySelectorAll('.start-session-btn').forEach(b => b.addEventListener('click', async () => {
    const r = await fetch('/api/admin/start-session', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ quizId: b.dataset.quizId })
    });
    if (r.ok) location.reload();
  }));
  const next = document.getElementById('next-item-btn');
  if (next) next.addEventListener('click', async () => {
    const r = await fetch(`/api/admin/advance-item/${next.dataset.session}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ itemIndex: 0 })
    });
    if (r.ok) location.reload();
  });
  const end = document.getElementById('end-session-btn');
  if (end) end.addEventListener('click', async () => {
    if (!confirm('End this live session?')) return;
    const r = await fetch(`/api/admin/end-session/${end.dataset.session}`, { method: 'POST' });
    if (r.ok) location.reload();
  });
  socket.on('live:submission', () => setTimeout(() => location.reload(), 1500));
  socket.on('live:warning', () => setTimeout(() => location.reload(), 1500));
</script>
