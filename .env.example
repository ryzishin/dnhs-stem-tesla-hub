# ==== STEM Tesla Hub configuration ====
# Copy this file to .env (local dev) or paste these into Render's Environment panel.

# MongoDB connection string.
#   Atlas : mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   Local : mongodb://localhost:27017
MONGODB_URI=

# Database name created inside that MongoDB server.
MONGODB_DB_NAME=stem_tesla_hub

# Long random string used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public address of the site (used for links and cookie settings).
PUBLIC_URL=http://localhost:3000

# Port (Render sets this automatically; local default is 3000).
PORT=3000

# production | development (changes logging verbosity)
NODE_ENV=development
