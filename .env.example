# MongoDB connection string.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (default: stem_tesla_biohub)
MONGODB_DB_NAME=stem_tesla_biohub

# Session secret — REQUIRED, NO DEFAULT.
# If this is missing or leaks, anyone can forge session cookies and become admin.
# Generate a strong one with: openssl rand -hex 32
SESSION_SECRET=

# Public-facing URL of the app.
PUBLIC_URL=http://localhost:3000

# Optional — pass "production" to switch Morgan to combined log format
# and hide err.message from the 500 error page (v2-P1-3).
NODE_ENV=development
