<div class="page-head">
  <p class="kicker admin">Live Monitor</p>
  <h1>Real-time class activity</h1>
</div>

<% if (activeSession) { %>
  <div class="card live-banner">
    <span class="live-pulse"></span>
    <div><strong><%= activeSession.quizzes && activeSession.quizzes.title %></strong>
      <div class="muted small">Item <%= activeSession.current_item_index + 1 %> of <%= activeSession.quizzes && activeSession.quizzes.items ? activeSession.quizzes.items.length : 0 %> · <%= (activeSession.participants || []).filter(p => p.status === 'submitted').length %>/<%= (activeSession.participants || []).length %> submitted</div>
    </div>
  </div>
<% } else { %>
  <div class="card">No active live session.</div>
<% } %>

<div class="grid grid-2">
  <div class="card">
    <h3>Participants (<%= students ? students.length : 0 %>)</h3>
    <div class="participant-list">
      <% (students || []).forEach(s => {
        const p = activeSession ? (activeSession.participants || []).find(x => x.user_id === s.id) : null;
      %>
        <div class="participant-row">
          <div class="avatar avatar-sm" style="--avatar-hue: <%= s.avatar_color || 200 %>;"><%= (s.name || '').split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase() %></div>
          <div><strong><%= s.name %></strong><div class="muted small"><%= p ? p.status : 'offline' %></div></div>
          <% if (p && p.warnings > 0) { %><span class="badge warn"><i data-lucide="triangle-alert" class="inline-icon"></i> <%= p.warnings %></span><% } %>
          <% if (p) { %><span class="badge">Score: <%= p.score %></span><% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card">
    <h3>Live activity feed</h3>
    <div class="activity-list">
      <% activity.forEach(ev => { %>
        <div class="activity-row">
          <span class="activity-kind kind-<%= ev.kind %>"><%= ev.kind.replace(/_/g, ' ') %></span>
          <strong><%= ev.user_name %></strong>
          <span class="muted"><%= ev.detail %></span>
          <span class="muted small"><%= new Date(ev.created_at).toLocaleString() %></span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>" src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  // Real-time updates via Socket.IO
  const socket = io({ auth: { userId: '<%= user.id %>' } });
  socket.emit('admin:subscribe_live');
  socket.on('activity:event', (ev) => {
    const list = document.querySelector('.activity-list');
    if (!list) return;
    const row = document.createElement('div');
    row.className = 'activity-row';
    row.innerHTML = `<span class="activity-kind kind-${ev.kind}">${ev.kind.replace(/_/g, ' ')}</span><strong>${ev.userName}</strong><span class="muted">${ev.detail}</span><span class="muted small">just now</span>`;
    list.prepend(row);
  });
  socket.on('live:participant_joined', ({ profile }) => {
    const list = document.querySelector('.participant-list');
    if (!list) return;
    // refresh via reload for simplicity
    setTimeout(() => location.reload(), 1500);
  });
  socket.on('live:submission', (data) => {
    setTimeout(() => location.reload(), 2000);
  });
</script>
