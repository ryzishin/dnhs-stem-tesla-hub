<div class="page-head">
  <p class="kicker">Notes Library</p>
  <h1>Biology 2 · Units</h1>
  <p class="muted">Tap any unit to read.</p>
</div>

<div class="grid grid-2">
  <% units.forEach(u => { %>
    <a href="/notes/<%= u.slug %>" class="card card-link">
      <div class="card-head">
        <div class="unit-num-badge"><%= u.number %></div>
        <div>
          <span class="card-kicker">Unit <%= u.number %></span>
          <h3><%= u.title %></h3>
        </div>
      </div>
      <p class="muted"><%= u.description %></p>
      <div class="card-meta">
        <span><%= u.parts.length %> part<%= u.parts.length !== 1 ? 's' : '' %></span>
        <span>· Updated <%= u.updatedAt || u.updated_at %></span>
      </div>
    </a>
  <% }) %>
</div>
