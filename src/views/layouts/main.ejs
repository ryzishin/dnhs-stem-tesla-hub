<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= (typeof title !== "undefined" && title ? title + " · " : "") %>STEM Tesla Hub</title>
  <meta name="description" content="The study hub of the STEM Tesla section, Dangcagan National High School — notes, practice quizzes, flashcards and live tests across subjects.">
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="preload" href="/fonts/PlusJakartaSans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <%- include("../partials/icons") %>

  <a class="skip-link" href="#main">Skip to content</a>

  <% if (typeof chrome !== "undefined" && chrome === "bare") { %>
    <%- body %>
  <% } else { %>
    <header class="site-header">
      <div class="container header-row">
        <a href="<%= currentUser ? '/hub' : '/' %>" class="brand">
          <img src="/assets/stem-logo.jpeg" alt="STEM Tesla logo" width="40" height="40" class="brand-logo">
          <span class="brand-text">
            <span class="brand-name">STEM Tesla <b>Hub</b></span>
            <span class="brand-school">Dangcagan National High School</span>
          </span>
        </a>

        <% if (currentUser) { %>
          <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
            <svg class="icon" aria-hidden="true"><use href="#i-menu"></use></svg>
          </button>
          <nav class="site-nav" id="site-nav" aria-label="Main">
            <a href="/hub" class="nav-link<%= currentPath === '/hub' ? ' is-active' : '' %>">Hub</a>
            <a href="/leaderboard" class="nav-link<%= currentPath.startsWith('/leaderboard') ? ' is-active' : '' %>">Leaderboard</a>
            <a href="/classmates" class="nav-link<%= currentPath.startsWith('/classmates') ? ' is-active' : '' %>">Classmates</a>
            <% if (currentUser.role === 'moderator' || currentUser.role === 'admin') { %>
              <a href="/build" class="nav-link<%= currentPath.startsWith('/build') ? ' is-active' : '' %>">Build</a>
            <% } %>
            <% if (currentUser.role === 'admin') { %>
              <a href="/host" class="nav-link<%= currentPath.startsWith('/host') ? ' is-active' : '' %>">Host</a>
              <a href="/admin" class="nav-link<%= currentPath.startsWith('/admin') ? ' is-active' : '' %>">Admin</a>
            <% } %>
            <a href="/profile" class="nav-user" aria-label="My profile">
              <%- avatarHtml(currentUser, 'avatar-sm') %>
              <span class="nav-user-name"><%= currentUser.name.split(' ')[0] %></span>
            </a>
            <form method="post" action="/logout" class="nav-logout">
              <button type="submit" class="btn btn-ghost btn-sm">
                <svg class="icon" aria-hidden="true"><use href="#i-logout"></use></svg> Log out
              </button>
            </form>
          </nav>
        <% } else { %>
          <nav class="site-nav site-nav-public" aria-label="Account">
            <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
            <a href="/register" class="btn btn-primary btn-sm">Create account</a>
          </nav>
        <% } %>
      </div>
    </header>

    <main id="main" class="site-main">
      <% if (flash) { %>
        <div class="container flash-wrap">
          <div class="flash flash-<%= flash.type %>" role="status">
            <svg class="icon" aria-hidden="true"><use href="#i-<%= flash.type === 'error' ? 'alert' : 'check' %>"></use></svg>
            <span><%= flash.message %></span>
            <button class="flash-close" aria-label="Dismiss">&times;</button>
          </div>
        </div>
      <% } %>
      <%- body %>
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <div class="footer-brand">
          <img src="/assets/stem-logo.jpeg" alt="" width="34" height="34" class="brand-logo">
          <div>
            <p class="footer-name">STEM Tesla Hub</p>
            <p class="footer-school">Dangcagan National High School · STEM Tesla</p>
          </div>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="/hub">Hub</a>
          <a href="/leaderboard">Leaderboard</a>
          <a href="/classmates">Classmates</a>
        </nav>
      </div>
      <div class="container footer-base">
        <p>Notes, practice quizzes, flashcards and live tests by the STEM Tesla section, for the STEM Tesla section.</p>
        <p>© <%= new Date().getFullYear() %> STEM Tesla · Dangcagan National High School</p>
      </div>
    </footer>
  <% } %>

  <% if (typeof pageScript !== "undefined" && pageScript) { %>
    <% if (pageScript === "live-student" || pageScript === "live-host") { %>
      <script src="/socket.io/socket.io.js"></script>
    <% } %>
    <script type="application/json" id="page-data"><%- json(locals.pageData || {}) %></script>
    <script src="/js/app.js" defer></script>
    <script src="/js/<%= pageScript %>.js" defer></script>
  <% } else { %>
    <script src="/js/app.js" defer></script>
  <% } %>
</body>
</html>
